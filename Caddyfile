# Reverse proxy + automatic HTTPS (Let's Encrypt) for the production stack.
#
# Replace yourdomain.com below with your real domain, then point both
# yourdomain.com and api.yourdomain.com at your VPS IP (see docs/DEPLOYMENT.md).
# Caddy requests and renews TLS certificates automatically — nothing else to configure.

{
	email you@example.com
}

yourdomain.com {
	reverse_proxy frontend:3000
}

api.yourdomain.com {
	reverse_proxy backend:8000
}
