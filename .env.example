# Copy this file to .env and fill in real values. Never commit .env.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (Supabase Postgres, session pooler connection) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# --- Backend / Auth ---
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# --- Discord OAuth (test server app) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
DISCORD_GUILD_ID=

# --- Discord Bot ---
DISCORD_BOT_TOKEN=
BOT_INTERNAL_API_URL=http://localhost:8001
BOT_INTERNAL_API_SECRET=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- NOWPayments ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Admin ---
# Comma-separated Discord user IDs allowed to access the admin dashboard.
ADMIN_DISCORD_IDS=

# --- Frontend (public, exposed to browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
